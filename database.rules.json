{
  "rules": {
    "borluulalt": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "eahs": {
      "v2": {
        ".read": "(auth != null && root.child('eahs/v2/roles/'+auth.uid+'/role').val() === 'hygiene')",
        "_meta": {
          ".write": "(auth != null && root.child('eahs/v2/roles/'+auth.uid+'/role').val() === 'hygiene') && !data.exists()"
        },
        "roles": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "(auth != null && root.child('eahs/v2/roles/'+auth.uid+'/role').val() === 'hygiene') || (auth != null && auth.uid === $uid && !data.exists() && newData.child('sap').isString() && auth.token.email === newData.child('sap').val().toLowerCase() + '@eahs.local' && root.child('eahs/v2/users/'+newData.child('sap').val()+'/pinHash').exists() && newData.child('proof').val() === root.child('eahs/v2/users/'+newData.child('sap').val()+'/pinHash').val() && newData.child('role').val() === root.child('eahs/v2/users/'+newData.child('sap').val()+'/role').val())",
            ".validate": "!newData.exists() || (newData.child('sap').isString() && newData.child('role').val().matches(/^(worker|supervisor|hygiene)$/))"
          }
        },
        "authgen": {
          "$sap": {
            ".read": true,
            ".write": "(auth != null && root.child('eahs/v2/roles/'+auth.uid+'/role').val() === 'hygiene')",
            ".validate": "!newData.exists() || newData.isString() || newData.isNumber()"
          }
        },
        "users": {
          ".read": "(auth != null && (root.child('eahs/v2/roles/'+auth.uid+'/role').val() === 'hygiene' || root.child('eahs/v2/roles/'+auth.uid+'/role').val() === 'supervisor'))",
          "$sap": {
            ".read": "auth != null && root.child('eahs/v2/roles/'+auth.uid+'/sap').val() === $sap",
            ".write": "(auth != null && root.child('eahs/v2/roles/'+auth.uid+'/role').val() === 'hygiene')",
            ".validate": "!newData.exists() || (newData.child('name').isString() && newData.child('role').val().matches(/^(worker|supervisor|hygiene)$/) && !newData.child('pin').exists() && (!newData.child('uid').exists() || newData.child('uid').isString()))",
            "uid": {
              ".write": "auth != null && root.child('eahs/v2/roles/'+auth.uid+'/sap').val() === $sap && !data.exists() && newData.val() === auth.uid"
            },
            "pinHash": {
              ".write": "auth != null && root.child('eahs/v2/roles/'+auth.uid+'/sap').val() === $sap && !newData.exists()"
            },
            "mustChange": {
              ".write": "auth != null && root.child('eahs/v2/roles/'+auth.uid+'/sap').val() === $sap"
            }
          }
        },
        "settings": {
          ".read": "(auth != null && root.child('eahs/v2/roles/'+auth.uid+'/role').exists())",
          ".write": "(auth != null && root.child('eahs/v2/roles/'+auth.uid+'/role').val() === 'hygiene')"
        },
        "uhaan": {
          ".read": "(auth != null && (root.child('eahs/v2/roles/'+auth.uid+'/role').val() === 'hygiene' || root.child('eahs/v2/roles/'+auth.uid+'/role').val() === 'supervisor')) || (auth != null && query.orderByChild === 'sap' && query.equalTo === root.child('eahs/v2/roles/'+auth.uid+'/sap').val())",
          ".indexOn": [
            "sap"
          ],
          ".write": "(auth != null && root.child('eahs/v2/roles/'+auth.uid+'/role').val() === 'hygiene')",
          "$id": {
            ".write": "((auth != null && root.child('eahs/v2/roles/'+auth.uid+'/role').val() === 'supervisor') && data.exists() && newData.exists() && ((data.child('alba').isString() && (data.child('alba').val().contains('Оффис') || data.child('alba').val().contains('оффис') || data.child('alba').val().contains('ОФФИС'))) ? 'Оффис' : 'Бар') === ((root.child('eahs/v2/users/'+root.child('eahs/v2/roles/'+auth.uid+'/sap').val()+'/alba').isString() && (root.child('eahs/v2/users/'+root.child('eahs/v2/roles/'+auth.uid+'/sap').val()+'/alba').val().contains('Оффис') || root.child('eahs/v2/users/'+root.child('eahs/v2/roles/'+auth.uid+'/sap').val()+'/alba').val().contains('оффис') || root.child('eahs/v2/users/'+root.child('eahs/v2/roles/'+auth.uid+'/sap').val()+'/alba').val().contains('ОФФИС'))) ? 'Оффис' : 'Бар')) || ((auth != null && root.child('eahs/v2/roles/'+auth.uid+'/role').exists()) && !data.exists() && newData.child('sap').val() === root.child('eahs/v2/roles/'+auth.uid+'/sap').val())"
          }
        },
        "fatigue": {
          ".read": "(auth != null && root.child('eahs/v2/roles/'+auth.uid+'/role').val() === 'hygiene') || (auth != null && query.orderByChild === 'sap' && query.equalTo === root.child('eahs/v2/roles/'+auth.uid+'/sap').val())",
          ".indexOn": [
            "sap"
          ],
          ".write": "(auth != null && root.child('eahs/v2/roles/'+auth.uid+'/role').val() === 'hygiene')",
          "$id": {
            ".write": "((auth != null && root.child('eahs/v2/roles/'+auth.uid+'/role').exists()) && !data.exists() && newData.child('sap').val() === root.child('eahs/v2/roles/'+auth.uid+'/sap').val())"
          }
        },
        "infect": {
          ".read": "(auth != null && root.child('eahs/v2/roles/'+auth.uid+'/role').val() === 'hygiene') || (auth != null && query.orderByChild === 'sap' && query.equalTo === root.child('eahs/v2/roles/'+auth.uid+'/sap').val())",
          ".indexOn": [
            "sap"
          ],
          ".write": "(auth != null && root.child('eahs/v2/roles/'+auth.uid+'/role').val() === 'hygiene')",
          "$id": {
            ".write": "((auth != null && root.child('eahs/v2/roles/'+auth.uid+'/role').exists()) && !data.exists() && newData.child('sap').val() === root.child('eahs/v2/roles/'+auth.uid+'/sap').val())"
          }
        },
        "roster": {
          ".read": "(auth != null && root.child('eahs/v2/roles/'+auth.uid+'/role').exists())",
          ".write": "(auth != null && root.child('eahs/v2/roles/'+auth.uid+'/role').val() === 'hygiene')"
        },
        "hygcheck": {
          ".read": "(auth != null && root.child('eahs/v2/roles/'+auth.uid+'/role').exists())",
          ".write": "(auth != null && root.child('eahs/v2/roles/'+auth.uid+'/role').val() === 'hygiene')",
          "$id": {
            ".write": "(auth != null && root.child('eahs/v2/roles/'+auth.uid+'/role').val() === 'supervisor') && newData.exists() && ((newData.child('alba').isString() && (newData.child('alba').val().contains('Оффис') || newData.child('alba').val().contains('оффис') || newData.child('alba').val().contains('ОФФИС'))) ? 'Оффис' : 'Бар') === ((root.child('eahs/v2/users/'+root.child('eahs/v2/roles/'+auth.uid+'/sap').val()+'/alba').isString() && (root.child('eahs/v2/users/'+root.child('eahs/v2/roles/'+auth.uid+'/sap').val()+'/alba').val().contains('Оффис') || root.child('eahs/v2/users/'+root.child('eahs/v2/roles/'+auth.uid+'/sap').val()+'/alba').val().contains('оффис') || root.child('eahs/v2/users/'+root.child('eahs/v2/roles/'+auth.uid+'/sap').val()+'/alba').val().contains('ОФФИС'))) ? 'Оффис' : 'Бар') && (!data.exists() || ((data.child('alba').isString() && (data.child('alba').val().contains('Оффис') || data.child('alba').val().contains('оффис') || data.child('alba').val().contains('ОФФИС'))) ? 'Оффис' : 'Бар') === ((root.child('eahs/v2/users/'+root.child('eahs/v2/roles/'+auth.uid+'/sap').val()+'/alba').isString() && (root.child('eahs/v2/users/'+root.child('eahs/v2/roles/'+auth.uid+'/sap').val()+'/alba').val().contains('Оффис') || root.child('eahs/v2/users/'+root.child('eahs/v2/roles/'+auth.uid+'/sap').val()+'/alba').val().contains('оффис') || root.child('eahs/v2/users/'+root.child('eahs/v2/roles/'+auth.uid+'/sap').val()+'/alba').val().contains('ОФФИС'))) ? 'Оффис' : 'Бар'))",
            "rows": {
              "$rk": {
                "sign": {
                  ".write": "auth != null && root.child('eahs/v2/roles/'+auth.uid+'/sap').val() !== null && newData.parent().child('sap').val() === root.child('eahs/v2/roles/'+auth.uid+'/sap').val()"
                },
                "signAt": {
                  ".write": "auth != null && root.child('eahs/v2/roles/'+auth.uid+'/sap').val() !== null && newData.parent().child('sap').val() === root.child('eahs/v2/roles/'+auth.uid+'/sap').val()"
                }
              }
            }
          }
        },
        "hazards": {
          ".read": "(auth != null && (root.child('eahs/v2/roles/'+auth.uid+'/role').val() === 'hygiene' || root.child('eahs/v2/roles/'+auth.uid+'/role').val() === 'supervisor'))",
          ".write": "(auth != null && root.child('eahs/v2/roles/'+auth.uid+'/role').val() === 'hygiene')",
          "$id": {
            ".write": "((auth != null && root.child('eahs/v2/roles/'+auth.uid+'/role').val() === 'supervisor') && data.exists() && newData.exists()) || (auth != null && !data.exists() && newData.child('status').val() === 'Шинэ')",
            ".validate": "!newData.exists() || !newData.child('det').exists() || (newData.child('det').isString() && newData.child('det').val().length <= 1000)"
          }
        },
        "photos": {
          ".read": "(auth != null && (root.child('eahs/v2/roles/'+auth.uid+'/role').val() === 'hygiene' || root.child('eahs/v2/roles/'+auth.uid+'/role').val() === 'supervisor'))",
          ".write": "(auth != null && root.child('eahs/v2/roles/'+auth.uid+'/role').val() === 'hygiene')",
          "$id": {
            ".write": "auth != null && !data.exists() && newData.parent().parent().child('hazards/'+$id).exists()"
          }
        },
        "notifs": {
          ".read": "(auth != null && (root.child('eahs/v2/roles/'+auth.uid+'/role').val() === 'hygiene' || root.child('eahs/v2/roles/'+auth.uid+'/role').val() === 'supervisor'))",
          ".write": "(auth != null && root.child('eahs/v2/roles/'+auth.uid+'/role').val() === 'hygiene')",
          "$id": {
            ".write": "(auth != null && !data.exists() && newData.exists() && ((newData.child('type').val() === 'hazard' && $id === 'hz_' + newData.child('ref').val() && (newData.parent().parent().child('hazards/'+newData.child('ref').val()+'/risk').val() === 'Их' || newData.parent().parent().child('hazards/'+newData.child('ref').val()+'/risk').val() === 'Маш их')) || (newData.child('type').val() === 'hygfail' && (auth != null && (root.child('eahs/v2/roles/'+auth.uid+'/role').val() === 'hygiene' || root.child('eahs/v2/roles/'+auth.uid+'/role').val() === 'supervisor'))))) || (auth != null && newData.exists() && newData.child('type').val() === 'health' && (auth != null && root.child('eahs/v2/roles/'+auth.uid+'/role').val() === 'supervisor') && ((newData.child('alba').isString() && (newData.child('alba').val().contains('Оффис') || newData.child('alba').val().contains('оффис') || newData.child('alba').val().contains('ОФФИС'))) ? 'Оффис' : 'Бар') === ((root.child('eahs/v2/users/'+root.child('eahs/v2/roles/'+auth.uid+'/sap').val()+'/alba').isString() && (root.child('eahs/v2/users/'+root.child('eahs/v2/roles/'+auth.uid+'/sap').val()+'/alba').val().contains('Оффис') || root.child('eahs/v2/users/'+root.child('eahs/v2/roles/'+auth.uid+'/sap').val()+'/alba').val().contains('оффис') || root.child('eahs/v2/users/'+root.child('eahs/v2/roles/'+auth.uid+'/sap').val()+'/alba').val().contains('ОФФИС'))) ? 'Оффис' : 'Бар') && (!data.exists() || data.child('type').val() === 'health'))",
            ".validate": "!newData.exists() || (newData.child('type').val().matches(/^(hazard|hygfail|health)$/) && newData.child('ts').isNumber() && newData.child('title').isString() && newData.child('title').val().length <= 200 && (!newData.child('body').exists() || (newData.child('body').isString() && newData.child('body').val().length <= 300)))"
          }
        },
        "renew": {
          ".read": "(auth != null && (root.child('eahs/v2/roles/'+auth.uid+'/role').val() === 'hygiene' || root.child('eahs/v2/roles/'+auth.uid+'/role').val() === 'supervisor')) || (auth != null && query.orderByChild === 'sap' && query.equalTo === root.child('eahs/v2/roles/'+auth.uid+'/sap').val())",
          ".indexOn": [
            "sap"
          ],
          ".write": "(auth != null && root.child('eahs/v2/roles/'+auth.uid+'/role').val() === 'hygiene')",
          "$id": {
            ".validate": "!newData.exists() || (newData.child('sap').isString() && newData.child('kind').val().matches(/^(book|exam)$/) && newData.child('exp').isString() && newData.child('exp').val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && (!newData.child('iss').exists() || (newData.child('iss').isString() && newData.child('iss').val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/))) && (!newData.child('note').exists() || (newData.child('note').isString() && newData.child('note').val().length <= 300)))"
          }
        },
        "svcheck": {
          ".read": "(auth != null && (root.child('eahs/v2/roles/'+auth.uid+'/role').val() === 'hygiene' || root.child('eahs/v2/roles/'+auth.uid+'/role').val() === 'supervisor'))",
          ".write": "(auth != null && root.child('eahs/v2/roles/'+auth.uid+'/role').val() === 'hygiene')",
          "$id": {
            ".write": "(auth != null && root.child('eahs/v2/roles/'+auth.uid+'/role').val() === 'supervisor') && newData.exists() && ((newData.child('alba').isString() && (newData.child('alba').val().contains('Оффис') || newData.child('alba').val().contains('оффис') || newData.child('alba').val().contains('ОФФИС'))) ? 'Оффис' : 'Бар') === ((root.child('eahs/v2/users/'+root.child('eahs/v2/roles/'+auth.uid+'/sap').val()+'/alba').isString() && (root.child('eahs/v2/users/'+root.child('eahs/v2/roles/'+auth.uid+'/sap').val()+'/alba').val().contains('Оффис') || root.child('eahs/v2/users/'+root.child('eahs/v2/roles/'+auth.uid+'/sap').val()+'/alba').val().contains('оффис') || root.child('eahs/v2/users/'+root.child('eahs/v2/roles/'+auth.uid+'/sap').val()+'/alba').val().contains('ОФФИС'))) ? 'Оффис' : 'Бар') && (!data.exists() || ((data.child('alba').isString() && (data.child('alba').val().contains('Оффис') || data.child('alba').val().contains('оффис') || data.child('alba').val().contains('ОФФИС'))) ? 'Оффис' : 'Бар') === ((root.child('eahs/v2/users/'+root.child('eahs/v2/roles/'+auth.uid+'/sap').val()+'/alba').isString() && (root.child('eahs/v2/users/'+root.child('eahs/v2/roles/'+auth.uid+'/sap').val()+'/alba').val().contains('Оффис') || root.child('eahs/v2/users/'+root.child('eahs/v2/roles/'+auth.uid+'/sap').val()+'/alba').val().contains('оффис') || root.child('eahs/v2/users/'+root.child('eahs/v2/roles/'+auth.uid+'/sap').val()+'/alba').val().contains('ОФФИС'))) ? 'Оффис' : 'Бар'))",
            ".validate": "!newData.exists() || (newData.child('tpl').isString() && newData.child('tpl').val().matches(/^(oyut|manlai)$/) && newData.child('start').isString() && newData.child('start').val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.child('heseg').val() === (newData.child('tpl').val() === 'oyut' ? 'Оюут' : 'Манлай') && newData.child('alba').val() === 'Бар')",
            "cells": {
              "$ik": {
                "$d": {
                  ".validate": "$d.matches(/^d[0-6]$/) && newData.isString() && newData.val().matches(/^(ok|imp|no)$/)"
                }
              }
            },
            "notes": {
              "$ik": {
                "$d": {
                  ".validate": "$d.matches(/^d[0-6]$/) && newData.isString() && newData.val().length <= 200"
                }
              }
            },
            "sign": {
              "$d": {
                ".validate": "$d.matches(/^d[0-6]$/) && newData.child('by').isString() && newData.child('by').val().length <= 80"
              }
